{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IGV SEC N-PORT normalized archive manifest v2",
  "description": "SCHEMA ONLY: no factual seed or verified SEC coverage is included. Python also verifies identity, source URLs, checksums, decimal precision, fiscal periods, amendments, complete rolling coverage and filing lag. External objects use the normalized_filing definition; raw XML and narrative are not permitted.",
  "type": "object",
  "required": ["schema_version", "data_kind", "source", "identity", "discovery_start_date", "last_successful_data_refresh_utc", "data_through", "filings", "quarters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "data_kind": {"$ref": "#/$defs/data_kind"},
    "source": {"const": "sec-edgar-nport"},
    "identity": {"$ref": "#/$defs/identity"},
    "discovery_start_date": {"type": "string", "format": "date"},
    "last_successful_data_refresh_utc": {"type": "string", "format": "date-time"},
    "data_through": {"type": "string", "format": "date"},
    "filings": {
      "type": "object",
      "minProperties": 20,
      "propertyNames": {"pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
      "additionalProperties": {"$ref": "#/$defs/object_reference"}
    },
    "quarters": {
      "type": "object",
      "minProperties": 20,
      "propertyNames": {"pattern": "^[0-9]{4}-[0-9]{2}$"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}
    }
  },
  "$defs": {
    "data_kind": {"enum": ["sec-nport-public-facts", "synthetic-test-only"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decimal": {
      "type": "string",
      "pattern": "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)$",
      "description": "Exact SEC decimal text, never a binary-float replacement. Python enforces at most 36 digits and 12 fractional places."
    },
    "optional_identifier": {"type": ["string", "null"]},
    "identifier_list": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registrant_cik", "series_id", "class_id", "ticker", "series_name", "mapping_url", "mapping_source_sha256", "resolved_at_utc"],
      "properties": {
        "registrant_cik": {"const": "0001100663"},
        "series_id": {"type": "string", "pattern": "^S[0-9]{9}$"},
        "class_id": {"type": "string", "pattern": "^C[0-9]{9}$"},
        "ticker": {"const": "IGV"},
        "series_name": {"const": "iShares Expanded Tech-Software Sector ETF"},
        "mapping_url": {"type": "string", "format": "uri"},
        "mapping_source_sha256": {"$ref": "#/$defs/sha256"},
        "resolved_at_utc": {"type": "string", "format": "date-time"}
      }
    },
    "object_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object", "sha256"],
      "properties": {
        "object": {"type": "string", "pattern": "^objects/[a-f0-9]{64}\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accession", "form", "filing_date", "accepted_at_utc", "source_url", "filing_url", "filing_index_sha256", "retrieved_at_utc", "source_sha256"],
      "properties": {
        "accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
        "form": {"enum": ["NPORT-P", "NPORT-P/A"]},
        "filing_date": {"type": "string", "format": "date"},
        "accepted_at_utc": {"type": "string", "format": "date-time"},
        "source_url": {"type": "string", "format": "uri"},
        "filing_url": {"type": "string", "format": "uri"},
        "filing_index_sha256": {"$ref": "#/$defs/sha256"},
        "retrieved_at_utc": {"type": "string", "format": "date-time"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "holding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_row", "source_row_sha256", "name", "title", "cusip", "lei", "isin", "ticker", "other", "asset_category", "issuer_category", "payoff_profile", "units", "currency", "balance", "market_value_usd", "weight_pct", "security_lending"],
      "properties": {
        "source_row": {"type": "integer", "minimum": 1},
        "source_row_sha256": {"$ref": "#/$defs/sha256"},
        "name": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "cusip": {"$ref": "#/$defs/optional_identifier"},
        "lei": {"$ref": "#/$defs/optional_identifier"},
        "isin": {"$ref": "#/$defs/identifier_list"},
        "ticker": {"$ref": "#/$defs/identifier_list"},
        "other": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "type"],
            "properties": {"value": {"type": "string"}, "type": {"type": "string"}}
          }
        },
        "asset_category": {"type": "string"},
        "issuer_category": {"type": "string"},
        "payoff_profile": {"type": "string"},
        "units": {"type": "string"},
        "currency": {"type": "string"},
        "balance": {"$ref": "#/$defs/decimal"},
        "market_value_usd": {"$ref": "#/$defs/decimal"},
        "weight_pct": {"$ref": "#/$defs/decimal"},
        "security_lending": {"$ref": "#/$defs/security_lending"}
      }
    },
    "security_lending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_cash_collateral", "cash_collateral_value_usd", "is_non_cash_collateral", "non_cash_collateral_value_usd", "is_loan_by_fund", "loan_value_usd"],
      "properties": {
        "is_cash_collateral": {"type": ["boolean", "null"]},
        "is_non_cash_collateral": {"type": ["boolean", "null"]},
        "is_loan_by_fund": {"type": ["boolean", "null"]},
        "cash_collateral_value_usd": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "non_cash_collateral_value_usd": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "loan_value_usd": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]}
      }
    },
    "normalized_filing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "data_kind", "source", "registrant_cik", "series_id", "series_name", "reported_as_of", "fiscal_year_end", "fiscal_quarter", "net_assets_usd", "source_row_count", "holdings", "provenance"],
      "properties": {
        "schema_version": {"const": 2},
        "data_kind": {"$ref": "#/$defs/data_kind"},
        "source": {"const": "sec-edgar-nport"},
        "registrant_cik": {"const": "0001100663"},
        "series_id": {"type": "string", "pattern": "^S[0-9]{9}$"},
        "series_name": {"type": "string"},
        "reported_as_of": {"type": "string", "format": "date"},
        "fiscal_year_end": {"type": "string", "format": "date"},
        "fiscal_quarter": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
        "net_assets_usd": {"$ref": "#/$defs/decimal"},
        "source_row_count": {"type": "integer", "minimum": 10},
        "holdings": {"type": "array", "minItems": 10, "maxItems": 10000, "items": {"$ref": "#/$defs/holding"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
